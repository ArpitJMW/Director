# Copy to .env for local development (loaded by dotenv-rails).

# --- Core ---
# Unix-socket / peer auth is used by default in development; override to force TCP:
# DATABASE_URL=postgres://user:pass@localhost:5432/clipify_development
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Falls back to Rails secret_key_base if unset. Set a dedicated value in production.
DEVISE_JWT_SECRET_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# --- AI / media providers ---
# LLM_PROVIDER: "anthropic" or "fake" (deterministic, offline). Defaults to
# "anthropic" when ANTHROPIC_API_KEY is set, otherwise "fake".
LLM_PROVIDER=
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# --- Object storage (Phase 4+) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
