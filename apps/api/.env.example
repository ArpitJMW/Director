# Copy to .env for local development (loaded by dotenv-rails).

# --- Core ---
# Unix-socket / peer auth is used by default in development; override to force TCP:
# DATABASE_URL=postgres://user:pass@localhost:5432/clipify_development
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Falls back to Rails secret_key_base if unset. Set a dedicated value in production.
DEVISE_JWT_SECRET_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# --- AI / media providers ---------------------------------------------------
# Each layer picks a provider from its *_PROVIDER var, else auto-detects from
# which API key is present, else falls back to the deterministic "fake" adapter.
#
# FREE STACK (recommended to start): Gemini + Cloudflare + edge-tts.
#   GEMINI_API_KEY=...            -> LLM
#   CLOUDFLARE_ACCOUNT_ID/TOKEN   -> images
#   VOICE_PROVIDER=edge_tts       -> narration (needs: pip install edge-tts)

# LLM: "gemini" | "anthropic" | "fake"
LLM_PROVIDER=
LLM_MODEL=            # e.g. gemini-2.5-flash | claude-haiku-4-5
GEMINI_API_KEY=       # https://aistudio.google.com/apikey  (free tier)
ANTHROPIC_API_KEY=    # https://console.anthropic.com

# Images: "cloudflare" | "gemini" | "fake"
IMAGE_PROVIDER=
IMAGE_MODEL=          # e.g. @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_ACCOUNT_ID=   # dash.cloudflare.com -> AI -> Workers AI  (free tier)
CLOUDFLARE_API_TOKEN=

# Voice: "edge_tts" | "elevenlabs" | "fake"   (edge_tts must be set explicitly)
VOICE_PROVIDER=
EDGE_TTS_VOICE=en-US-AriaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Rendering ---
# Absolute base URL the renderer uses to fetch signed asset URLs.
RENDER_ASSET_BASE_URL=http://localhost:3000

# --- Object storage ---
# STORAGE_BACKEND: "disk" (local, dev/test) or "s3". Defaults to "disk" unless
# S3_BUCKET is set.
STORAGE_BACKEND=disk
# S3 / Cloudflare R2 (set S3_ENDPOINT for R2; leave blank for AWS S3):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
